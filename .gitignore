# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/
build/
dist/

# Studio local state and user-generated assets
.studio/
.11vated-studio/
workspace/
artifacts/
evidence/
models/
model-cache/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Native application caches
.blender*
.godot/
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Library/
Temp/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# EMBERKEEP production (added P0)
Games/**/dist/
Games/**/.godot/
Games/**/.import/
reports/evidence/_staging/
*.pdb
# The evidence bundle IS the product's proof; the generic evidence/ rule above must not swallow it.
!reports/evidence/
# Raw generation outputs are hash-addressed, not committed (reports/evidence/ARTIFACTS.sha256).
# Release evidence under reports/evidence/productions/ stays tracked.
reports/evidence/comfyui-output/
reports/evidence/runs/

# The manifest tool itself lives in a directory named evidence.
!scripts/evidence/
