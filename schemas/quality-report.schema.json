{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://11vatedtech.invalid/schemas/quality-report.schema.json",
  "title": "Studio Quality Report",
  "type": "object",
  "required": ["report_id", "subject_id", "suite_version", "verdict", "criteria", "created_at"],
  "properties": {
    "report_id": {"type": "string"},
    "subject_id": {"type": "string"},
    "suite_version": {"type": "string"},
    "verdict": {"enum": ["PASS", "PASS_WITH_APPROVED_LIMITATIONS", "FAIL", "BLOCKED"]},
    "criteria": {"type": "array", "items": {"type": "object", "required": ["criterion_id", "status", "evidence"], "properties": {"criterion_id": {"type": "string"}, "status": {"enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED", "WAIVED_WITH_APPROVAL"]}, "severity": {"enum": ["P0", "P1", "P2", "INFO"]}, "actual": {}, "expected": {}, "evidence": {"type": "array", "items": {"type": "string"}}, "issue_id": {"type": "string"}}}},
    "environment": {"type": "object"},
    "tool_versions": {"type": "object"},
    "reviewers": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
