{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://11vatedtech.invalid/schemas/capability.schema.json",
  "title": "Studio Capability",
  "type": "object",
  "required": ["id", "version", "domain", "outcome", "inputs", "outputs", "permissions", "maturity", "acceptance_tests"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "version": {"type": "string"},
    "domain": {"type": "string"},
    "outcome": {"type": "string", "minLength": 10},
    "inputs": {"type": "array", "items": {"type": "object", "required": ["name", "schema"], "properties": {"name": {"type": "string"}, "schema": {"type": "object"}, "required": {"type": "boolean"}}}},
    "outputs": {"type": "array", "items": {"type": "object", "required": ["name", "schema"], "properties": {"name": {"type": "string"}, "schema": {"type": "object"}}}},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "side_effect_class": {"enum": ["READ", "CREATE", "MODIFY", "DELETE", "EXECUTE", "NETWORK", "CREDENTIAL", "PUBLISH"]},
    "maturity": {"enum": ["L0", "L1", "L2", "L3", "L4", "L5"]},
    "support_matrix": {"type": "array", "items": {"type": "object"}},
    "resource_profile": {"type": "object"},
    "acceptance_tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "provenance": {"type": "object"},
    "known_limitations": {"type": "array", "items": {"type": "string"}},
    "owner": {"type": "string"}
  },
  "additionalProperties": false
}
