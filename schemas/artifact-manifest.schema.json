{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://11vatedtech.invalid/schemas/artifact-manifest.schema.json",
  "title": "Studio Artifact Manifest",
  "type": "object",
  "required": ["artifact_id", "project_id", "artifact_type", "version", "files", "origin", "validation_state"],
  "properties": {
    "artifact_id": {"type": "string"},
    "project_id": {"type": "string"},
    "task_id": {"type": "string"},
    "artifact_type": {"type": "string"},
    "display_name": {"type": "string"},
    "version": {"type": "string"},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256", "size_bytes"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "size_bytes": {"type": "integer", "minimum": 0}, "format": {"type": "string"}}}},
    "parents": {"type": "array", "items": {"type": "string"}},
    "origin": {"enum": ["human", "generated", "third_party", "derived"]},
    "provenance": {"type": "object"},
    "license": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["cleared", "restricted", "unknown", "blocked"]}, "identifier": {"type": "string"}, "source_url": {"type": "string", "format": "uri"}}},
    "toolchain": {"type": "array", "items": {"type": "object"}},
    "validation_state": {"enum": ["working", "review", "approved_source", "exported", "integrated", "released", "rejected"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
