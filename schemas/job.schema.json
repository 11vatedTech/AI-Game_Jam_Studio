{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://11vatedtech.invalid/schemas/job.schema.json",
  "title": "Studio Production Job",
  "type": "object",
  "required": ["job_id", "project_id", "state", "nodes", "created_at"],
  "properties": {
    "job_id": {"type": "string"},
    "project_id": {"type": "string"},
    "idempotency_key": {"type": "string"},
    "state": {"enum": ["CREATED", "VALIDATING", "READY", "RUNNING", "WAITING_FOR_TOOL", "WAITING_FOR_APPROVAL", "WAITING_FOR_RESOURCE", "VERIFYING", "SUCCEEDED", "FAILED", "CANCELLED", "BLOCKED", "NEEDS_RECONCILIATION"]},
    "nodes": {"type": "array", "items": {"type": "object", "required": ["node_id", "capability_id", "dependencies", "state"], "properties": {"node_id": {"type": "string"}, "capability_id": {"type": "string"}, "dependencies": {"type": "array", "items": {"type": "string"}}, "state": {"type": "string"}, "input_artifacts": {"type": "array"}, "output_artifacts": {"type": "array"}}}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "evidence_root": {"type": "string"}
  },
  "additionalProperties": false
}
